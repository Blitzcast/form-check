# Copy to .env and fill in. .env is gitignored.

# Supabase (use a separate project from Feed Cleaner)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only. In production set it with `npx wrangler secret put SUPABASE_SECRET_KEY`;
# for `wrangler dev` put it in site/.dev.vars. Never ship it to the browser.
SUPABASE_SECRET_KEY=

# Cloudflare: used by wrangler when you deploy from your machine
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
